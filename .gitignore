# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Cartella download temporanei
downloads/*
!downloads/.gitkeep

# Cartella allegati multimediali permanenti (foto, screenshot)
allegati/*
!allegati/.gitkeep

# File di ambiente con token e credenziali
.env

# Database locale SQLite di runtime
memobot.db

# Cartelle di backup fisiche
backups/

# Credenziali Google Calendar e note OAuth
credentials.json
token.json
IDCLIENT_OAuth_Google.*

# Preferenze utente locali
user_settings.json
*.docx

# Modelli neurali pesanti (Kokoro ONNX, XTTS)
models/*
!models/.gitkeep
*.onnx
*.bin

# Cartella file podcast generati
podcasts/*
!podcasts/.gitkeep

# Worker isolato Voice Cloning GPU
worker_tts/venv/
worker_tts/__pycache__/

# File campioni vocali personali
voci/*
!voci/.gitkeep
!voci/README_VOCI.md
