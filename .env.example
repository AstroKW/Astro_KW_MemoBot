# ==============================================================================
# Astro_KW MemoBot — File di Configurazione (.env.example)
# Rinomina questo file in '.env' e inserisci i tuoi parametri.
# ==============================================================================

# 1. TELEGRAM BOT
# Inserisci il token segreto del tuo bot ottenuto parlando con @BotFather su Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_esempio

# ID numerici Telegram degli utenti autorizzati, separati da virgola (es: 123456789,987654321)
# Se vuoto, al primo messaggio il bot accetterà la sincronizzazione segnalando nella console il tuo ID numerico.
ALLOWED_TELEGRAM_USER_IDS=

# 2. CONFIGURAZIONE MOTORE INTELLIGENZA ARTIFICIALE (LOCALE O CLOUD)
# Scegli il tuo fornitore: 'ollama' (locale), 'gemini', 'groq', 'openai', 'openrouter', 'custom'
# Predefinito: ollama (100% privacy locale offline)
AI_PROVIDER=ollama

# --- FORNITORE A: OLLAMA (LOCALE - PRIVACY 100%) ---
# Modello testo (consigliato: qwen2.5:14b o qwen2.5:7b)
OLLAMA_MODEL=qwen2.5:14b
# Modello Vision / OCR per foto e schermate (es. qwen2.5vl:7b)
OLLAMA_VISION_MODEL=qwen2.5vl:7b
# Indirizzo server Ollama locale
OLLAMA_HOST=http://localhost:11434

# --- FORNITORE B: GOOGLE GEMINI (CLOUD GRATUITO CONSIGLIATO) ---
# Ottieni la chiave gratuita in 30 secondi su: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- FORNITORE C: GROQ (CLOUD ULTRA-VELOCE E GRATUITO/ECONOMICO) ---
# Ottieni la chiave su: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# --- FORNITORE D: OPENAI CHATGPT (CLOUD) ---
# Ottieni la chiave su: https://platform.openai.com/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- FORNITORE E: OPENROUTER (TUTTI I MODELLI CLOUD IN UN UNICO ACCOUNT) ---
# Ottieni la chiave su: https://openrouter.ai/
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct

# --- FORNITORE F: ENDPOINT OPENAI COMPATIBILE PERSONALIZZATO ---
CUSTOM_OPENAI_BASE_URL=
CUSTOM_OPENAI_API_KEY=
CUSTOM_OPENAI_MODEL=

# 3. GOOGLE CALENDAR
# Nome del calendario dedicato che MemoBot cercherà o creerà automaticamente sul tuo account Google
GOOGLE_CALENDAR_NAME=MemoBot
